model WorkCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  specialties WorkCategorySpecialty[]

  @@map("work_categories")
}

model WorkCategorySpecialty {
  categoryId  String @map("category_id") @db.Uuid
  specialtyId String @map("specialty_id") @db.Uuid

  category  WorkCategory @relation(fields: [categoryId], references: [id])
  specialty Specialty    @relation(fields: [specialtyId], references: [id])

  @@id([categoryId, specialtyId])
  @@map("work_category_specialties")
}
