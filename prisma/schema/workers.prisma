model WorkerProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userProfileId       String?   @unique @map("user_profile_id") @db.Uuid // 1 perfil público por usuario
  publisherType       String    @default("individual") @map("publisher_type")
  fullName            String    @map("full_name")
  businessName        String?   @map("business_name")
  contactPersonName   String?   @map("contact_person_name")
  contactPersonRole   String?   @map("contact_person_role")
  whatsapp            String    @default("")
  documentType        String    @default("dni") @map("document_type")
  documentNumber      String    @default("") @map("document_number")
  profilePhotoUrl     String?   @map("profile_photo_url")
  presentation        String?
  yearsOfExperience   Int       @default(0) @map("years_of_experience")
  levelId             String?   @map("level_id") @db.Uuid
  availabilityId      String    @map("availability_id") @db.Uuid
  departmentCode      String    @map("department_code")
  departmentName      String    @map("department_name")
  cityCode            String    @map("city_code")
  cityName            String    @map("city_name")
  districtCode        String    @map("district_code")
  districtName        String    @map("district_name")
  subscriptionScore   Int       @default(0) @map("subscription_score")
  isFeatured          Boolean   @default(false) @map("is_featured")
  isVerified          Boolean   @default(false) @map("is_verified")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  userProfile        UserProfile?             @relation(fields: [userProfileId], references: [id])
  level              WorkerLevel?             @relation(fields: [levelId], references: [id])
  availability       AvailabilityStatus       @relation(fields: [availabilityId], references: [id])
  specialties        WorkerProfileSpecialty[]
  categories         WorkerProfileCategory[]
  machinery          WorkerProfileMachinery[]
  coverageDistricts  WorkerCoverageDistrict[]
  images             WorkerImage[]
  reviews            WorkerReview[]

  @@index([isDeleted, subscriptionScore, updatedAt])
  @@index([publisherType])
  @@index([departmentCode, cityCode, districtCode])
  @@map("worker_profiles")
}
