model WorkerReview {
  id                String    @id @default(uuid()) @db.Uuid
  workerProfileId   String    @map("worker_profile_id") @db.Uuid
  authorUserProfileId String  @map("author_user_profile_id") @db.Uuid
  body              String
  rating            Int       @default(5)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])
  author        UserProfile   @relation(fields: [authorUserProfileId], references: [id])
  images        WorkerReviewImage[]

  @@unique([workerProfileId, authorUserProfileId])
  @@index([workerProfileId, isDeleted, createdAt])
  @@map("worker_reviews")
}

model WorkerReviewImage {
  id                 String    @id @default(uuid()) @db.Uuid
  reviewId           String    @map("review_id") @db.Uuid
  url                String
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  sortOrder          Int       @default(0) @map("sort_order")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  review WorkerReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId, sortOrder])
  @@map("worker_review_images")
}
