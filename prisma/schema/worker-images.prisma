model WorkerImage {
  id                 String    @id @default(uuid()) @db.Uuid
  workerProfileId    String    @map("worker_profile_id") @db.Uuid
  url                String
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  altText            String?   @map("alt_text")
  sortOrder          Int       @default(0) @map("sort_order")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])

  @@index([workerProfileId, sortOrder])
  @@map("worker_images")
}
